{
  "name": "@urbankitstudio/mcp-atlas",
  "version": "0.2.4",
  "mcpName": "io.github.LEOyrh/mcp-atlas",
  "description": "Query the verified parcel ArcGIS REST endpoints of 227 counties across all 50 US states (241 layers) for owner, APN and address lookup via the Model Context Protocol (MCP).",
  "keywords": [
    "mcp",
    "mcp-server",
    "parcel",
    "gis",
    "arcgis",
    "county",
    "apn",
    "address-to-parcel",
    "property-data",
    "real-estate",
    "esri"
  ],
  "homepage": "https://urbankitstudio.com/parcel-atlas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urbankitstudio/mcp-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/urbankitstudio/mcp-atlas/issues"
  },
  "author": "UrbanKit Studio <urbankitstudio@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "mcp-atlas": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY-NOTES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "smoke": "node test/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@urbankitstudio/atlas": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
